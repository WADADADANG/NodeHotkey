      "toNodeId": "node_snap_error",
      "toPort": "exec_in"
    },
    {
      "id": "conn_buff_cast",
      "fromNodeId": "node_party_buff",
      "fromPort": "onNextMember",
      "toNodeId": "node_cast_buff",
      "toPort": "exec_in"
    },
    {
      "id": "conn_buff_complete",
      "fromNodeId": "node_party_buff",
      "fromPort": "onComplete",
      "toNodeId": "node_tts_complete",
      "toPort": "exec_in"
    },
    {
      "id": "conn_trig2_press",
      "fromNodeId": "node_trig_keys",
      "fromPort": "exec_out",
      "toNodeId": "node_key_press",
      "toPort": "exec_in"
    },
    {
      "id": "conn_press_delay",
      "fromNodeId": "node_key_press",
      "fromPort": "onComplete",
      "toNodeId": "node_delay",
      "toPort": "exec_in"
    },
    {
      "id": "conn_delay_sound",
      "fromNodeId": "node_delay",
      "fromPort": "onComplete",
      "toNodeId": "node_sound",
      "toPort": "exec_in"
    }
  ]
}