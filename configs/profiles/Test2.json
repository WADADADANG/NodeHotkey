  "connections": [
    {
      "id": "conn_trig1_scanner",
      "fromNodeId": "node_trig_party",
      "fromPort": "exec_out",
      "toNodeId": "node_party_scanner",
      "toPort": "exec_in"
    },
    {
      "id": "conn_scanner_buff",
      "fromNodeId": "node_party_scanner",
      "fromPort": "onScanned",
      "toNodeId": "node_party_buff",
      "toPort": "exec_in"
    },
    {
      "id": "conn_scanner_err_tts",
      "fromNodeId": "node_party_scanner",
      "fromPort": "onError",
      "toNodeId": "node_tts_error",
      "toPort": "exec_in"
    },
    {
      "id": "conn_scanner_err_snap",
      "fromNodeId": "node_party_scanner",
